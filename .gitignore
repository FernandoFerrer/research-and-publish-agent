# Approved PUBLIC/SYNTHETIC sample data can be added explicitly with:
# git add -f path/to/reviewed-sample.csv
# Do not force-add credentials, user data, or copyrighted source documents.

# -----------------------------------------------------------------------------
# 5. Generated websites and frontend dependencies
# -----------------------------------------------------------------------------
/site/
/.next/
/.nuxt/
/.astro/
/.vite/
/node_modules/
/.npm/
/.yarn/cache/
/.pnpm-store/

# Keep GitHub Pages source, such as docs/, public/, articles/, content/,
# .github/workflows/, and site configuration files tracked when appropriate.

# -----------------------------------------------------------------------------
# 6. Notebook checkpoints, local IDE files, OS artifacts, and editor backups
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.nbconvert.ipynb
.vscode/
.idea/
.fleet/
*.code-workspace
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# 7. Local backups and accidental exports
# -----------------------------------------------------------------------------
*.bak
*.backup
*.orig
*.tmp
*.temp
*.old
*.sql.gz
*.dump

# Security note: before the first public push, inspect `git status`,
# `git ls-files`, and the full Git history. Enable GitHub secret scanning/
# push protection, and use a secret scanner in pre-commit and CI.
