# research-and-publish-agent
# Public repository: exclude credentials, private data, local state, and builds.
# IMPORTANT: .gitignore does NOT protect tracked files or Git history.
# Review every file before committing; use secret scanning and push protection.

# -----------------------------------------------------------------------------
# 1. Secrets and machine-specific configuration (at any directory level)
# -----------------------------------------------------------------------------
.env
.env.*
.envrc
*.env
*.env.*
*.local
*.local.*

# Only sanitized examples with placeholder values may be committed.
!.env.example
!.env.sample
!.env.template
!*.env.example
!*.env.sample
!*.env.template

**/secrets/
**/.secrets/
**/private/
**/.ssh/
**/.aws/
**/.azure/
**/.kube/
**/.config/gcloud/
**/.docker/config.json
**/.npmrc
**/.pypirc
**/.netrc
**/kubeconfig

*secret*.json
*secret*.yaml
*secret*.yml
*secret*.toml
*credential*.json
*credential*.yaml
*credential*.yml
*token*.json
*service-account*.json
*service_account*.json
*oauth*.json

*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json

# Dagster instance config can contain secrets; publish a sanitized example.
/dagster.yaml

# -----------------------------------------------------------------------------
# 2. Python environments, dependencies, caches, and test artifacts
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
__pypackages__/
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
.eggs/
*.whl
build/
dist/
.pip-cache/
.uv-cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.pyright/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.prof
*.pstats

# Keep dependency lockfiles tracked (for example, uv.lock or poetry.lock).

# -----------------------------------------------------------------------------
# 3. Dify, Dagster, RAG, vector stores, and runtime state
# -----------------------------------------------------------------------------
/.dagster/
/.dagster_home/
/dagster_home/
/dagster_storage/
/dagster_logs/
/.dify/
/dify/docker/volumes/
/docker/volumes/
/volumes/
/chroma/
/chroma_db/
/qdrant_storage/
/faiss_index/
/lancedb/
/vectorstore/
/vector_store/
/storage/

*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db
*.db-*
*.duckdb
*.duckdb.wal
*.faiss
*.index
*.pkl
*.pickle
*.joblib

# Keep reviewed Dify workflow definitions, schemas, and orchestration code.

# -----------------------------------------------------------------------------
# 4. Downloaded research, datasets, logs, and generated local outputs
# -----------------------------------------------------------------------------
/data/
/datasets/
/downloads/
/papers/
/raw/
/scrapes/
/research_cache/
/source_cache/
/artifacts/
/outputs/
/runs/
/cache/
/tmp/
/temp/
/logs/
/exports/
/captures/

*.log
*.log.*
*.har
*.csv
*.tsv
*.jsonl
*.ndjson
*.parquet
*.arrow
*.feather
*.xlsx
*.xls
*.docx
*.pptx
*.pdf
*.zip
*.tar
*.tar.gz
*.7z
